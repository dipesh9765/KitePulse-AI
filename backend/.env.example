# =================================================================
# KitePulse AI - Environment Configuration Template
# Copy this file to .env and fill in your private API credentials:
# cp .env.example .env
# =================================================================

# Zerodha Kite Connect Credentials
# Obtain from https://kite.trade/ developer console
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Optional: Pre-authenticated tokens (can also be entered via web UI)
KITE_ACCESS_TOKEN=
KITE_REQUEST_TOKEN=

# Google Gemini API Key
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Operational Trading Mode: "PAPER" (virtual simulation) or "LIVE" (Zerodha MIS)
TRADING_MODE=PAPER
